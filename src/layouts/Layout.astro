---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Perfecciona tu café con guías paso a paso impulsadas por IA' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-[#212529] text-[#f8f9fa] font-sans antialiased overflow-x-hidden">
    <Navbar />
    <main>
      <slot />
    </main>

    <script>
      import LocomotiveScroll from 'locomotive-scroll';

      const locomotiveScroll = new LocomotiveScroll({
        lenisOptions: {
          lerp: 0.07,
          duration: 1.5,
          smoothWheel: true,
          wheelMultiplier: 0.8,
        }
      });
    </script>
  </body>
</html>

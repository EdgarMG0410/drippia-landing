<section class="relative py-32 md:py-48 lg:py-56 px-6">
  <div class="max-w-5xl mx-auto">
    <p id="text-reveal" class="font-display text-[clamp(1.6rem,4vw,3.2rem)] font-semibold leading-[1.35] tracking-tight text-center">
      No más café mediocre. Registra cada grano que compras. Crea recetas para tu método favorito. Prepara con guía paso a paso y timer integrado. Mejora con cada taza.
    </p>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const textEl = document.getElementById('text-reveal');
    if (!textEl) return;

    // Split text into word spans
    const text = textEl.textContent!.trim();
    textEl.innerHTML = text
      .split(/\s+/)
      .map((word) => `<span class="inline-block" style="opacity: 0.1; color: #495057; transition: color 0.1s;">${word}</span>`)
      .join(' ');

    const words = textEl.querySelectorAll('span');

    // Scrub animation: words light up as you scroll
    gsap.to(words, {
      opacity: 1,
      color: '#f8f9fa',
      stagger: { each: 1 / words.length },
      scrollTrigger: {
        trigger: textEl,
        start: 'top 75%',
        end: 'bottom 35%',
        scrub: 1,
      },
    });
  });
</script>

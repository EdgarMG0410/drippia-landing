---
import Aurora from "./Aurora";
---

<section class="relative min-h-screen flex flex-col items-center justify-center pt-24 pb-0 overflow-hidden">
  <!-- Aurora Background -->
  <div class="absolute inset-0 z-0 opacity-15">
    <Aurora client:load colorStops={["#495057", "#343a40", "#6c757d"]} amplitude={1.0} blend={0.4} />
  </div>

  <!-- Grain overlay for texture -->
  <div class="absolute inset-0 z-[1] opacity-[0.03] pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>

  <!-- Content -->
  <div class="relative z-10 text-center px-6 max-w-5xl mx-auto flex-1 flex flex-col items-center justify-center">
    <!-- Badge -->
    <div class="hero-badge opacity-0 inline-flex items-center gap-2.5 border border-[#495057] rounded-full px-5 py-2 mb-8">
      <span class="w-1.5 h-1.5 bg-[#adb5bd] rounded-full"></span>
      <span class="text-[#adb5bd] text-[11px] font-semibold tracking-[0.25em] uppercase">Café de especialidad</span>
    </div>

    <!-- Main Heading -->
    <h1 class="hero-title opacity-0 font-display text-[clamp(3.2rem,10vw,9rem)] font-bold leading-[0.92] tracking-tight mb-8">
      Perfección<br/>en tu taza.
    </h1>

    <!-- Subtitle -->
    <p class="hero-subtitle opacity-0 text-[clamp(1rem,2.5vw,1.35rem)] text-[#adb5bd] max-w-xl mx-auto mb-10 leading-relaxed font-light">
      Domina el arte del café de especialidad con guías inteligentes, un barista IA y el registro de cada preparación.
    </p>

    <!-- Beta Form -->
    <form id="hero-form" class="hero-form opacity-0 flex flex-col sm:flex-row gap-3 w-full max-w-md mx-auto mb-4">
      <input
        type="email"
        name="email"
        placeholder="tu@email.com"
        class="flex-1 px-5 py-3.5 text-sm rounded-full bg-[#343a40] border border-[#495057] text-[#f8f9fa] placeholder-[#6c757d] focus:outline-none focus:border-[#adb5bd] transition-colors duration-300"
        required
      />
      <button
        type="submit"
        class="px-8 py-3.5 text-sm bg-[#f8f9fa] text-[#212529] font-bold rounded-full hover:bg-[#e9ecef] transition-all duration-300 whitespace-nowrap"
      >
        Accede a la beta
      </button>
    </form>

    <p id="hero-form-msg" class="hero-msg opacity-0 text-[#6c757d] text-xs mb-10">Próximamente en iOS y Android</p>

    <!-- Store Buttons -->
    <div class="hero-stores opacity-0 flex gap-3 justify-center mb-12">
      <div class="flex items-center gap-2.5 px-4 py-2.5 border border-[#495057]/60 rounded-xl text-[#adb5bd] hover:border-[#6c757d] transition-colors cursor-default">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"></path></svg>
        <span class="text-sm font-medium">App Store</span>
      </div>
      <div class="flex items-center gap-2.5 px-4 py-2.5 border border-[#495057]/60 rounded-xl text-[#adb5bd] hover:border-[#6c757d] transition-colors cursor-default">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"></path></svg>
        <span class="text-sm font-medium">Google Play</span>
      </div>
    </div>
  </div>

  <!-- Phone Mockup -->
  <div class="hero-mockup opacity-0 relative z-10 w-full flex justify-center mt-auto">
    <picture>
      <source media="(min-width: 1024px)" srcset="/assets/drippia-hero.png" />
      <img
        src="/assets/hero-mobile.png"
        alt="Drippia App"
        class="w-auto max-h-[35vh] sm:max-h-[40vh] lg:max-h-[50vh] object-contain animate-float"
      />
    </picture>
  </div>

  <!-- Scroll Indicator -->
  <div class="hero-scroll opacity-0 absolute bottom-8 left-1/2 -translate-x-1/2 z-20">
    <div class="flex flex-col items-center gap-2 text-[#6c757d]">
      <span class="text-[10px] tracking-[0.3em] uppercase font-medium">Scroll</span>
      <div class="w-px h-8 bg-gradient-to-b from-[#6c757d] to-transparent" style="animation: pulse-line 2s ease-in-out infinite;"></div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    // Set initial Y offsets
    gsap.set('.hero-badge', { y: 20 });
    gsap.set('.hero-title', { y: 60 });
    gsap.set('.hero-subtitle', { y: 30 });
    gsap.set('.hero-form', { y: 20 });
    gsap.set('.hero-msg', { y: 10 });
    gsap.set('.hero-mockup', { y: 80 });

    // Entrance timeline
    const tl = gsap.timeline({ delay: 0.2 });

    tl.to('.hero-badge', { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' })
      .to('.hero-title', { opacity: 1, y: 0, duration: 1.2, ease: 'power3.out' }, '-=0.5')
      .to('.hero-subtitle', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' }, '-=0.6')
      .to('.hero-form', { opacity: 1, y: 0, duration: 0.7, ease: 'power2.out' }, '-=0.4')
      .to('.hero-msg', { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, '-=0.3')
      .to('.hero-stores', { opacity: 1, duration: 0.5, ease: 'power2.out' }, '-=0.2')
      .to('.hero-mockup', { opacity: 1, y: 0, duration: 1.4, ease: 'power3.out' }, '-=0.5')
      .to('.hero-scroll', { opacity: 1, duration: 0.4 }, '-=0.3');
  });

  // Form handling
  const form = document.getElementById('hero-form') as HTMLFormElement;
  const msg = document.getElementById('hero-form-msg') as HTMLParagraphElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = new FormData(form).get('email') as string;
    if (!email) return;

    const btn = form.querySelector('button')!;
    btn.textContent = 'Enviando...';
    btn.disabled = true;

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });

      if (res.ok) {
        msg.textContent = '✓ Te hemos agregado a la lista de espera';
        msg.style.color = '#adb5bd';
        form.reset();
        btn.textContent = '✓ Listo';

        if (typeof gtag !== 'undefined') {
          gtag('event', 'beta_signup', { event_category: 'engagement', event_label: 'hero_form' });
        }
      } else {
        throw new Error();
      }
    } catch {
      msg.textContent = 'Error al registrar. Intenta de nuevo.';
      msg.style.color = '#dc3545';
      btn.textContent = 'Accede a la beta';
    }

    btn.disabled = false;

    setTimeout(() => {
      msg.textContent = 'Próximamente en iOS y Android';
      msg.style.color = '#6c757d';
      btn.textContent = 'Accede a la beta';
    }, 4000);
  });

  declare global {
    function gtag(command: string, eventName: string, parameters?: Record<string, any>): void;
  }
</script>

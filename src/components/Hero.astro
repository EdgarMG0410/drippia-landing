---
---

<section class="min-h-screen bg-zinc-900 flex items-center">
  <div class="container mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-8 items-center">
      <!-- Columna de texto -->
      <div class="text-center lg:text-left">
        <h1 class="text-[clamp(3rem,6.3vw,8rem)] font-light mb-6 leading-[1.10] text-white">
          Prepara café<br/>excepcional
        </h1>

        <p class="text-[1rem] sm:text-sm md:text-2xl text-white/90 mb-8 leading-snug max-w-sm sm:max-w-md lg:max-w-2xl mx-auto lg:mx-0">
          Tu compañero personal para dominar el arte del café de especialidad.
          Guías paso a paso que extraen el máximo potencial de cada grano.
        </p>

        <div class="mb-8">
          <p class="text-white text-[0.5rem] sm:text-xs lg:text-lg font-semibold mb-3 text-center lg:text-left">
            Próximamente
          </p>
          <div class="flex flex-row gap-4 justify-center lg:justify-start">
            <div class="bg-black text-white px-4 py-3 lg:px-6 lg:py-4 rounded-lg flex items-center gap-3 border border-white/10">
              <svg class="w-6 h-6 lg:w-7 lg:h-7" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"></path>
              </svg>
              <div class="flex flex-col items-start">
                <span class="text-sm lg:text-lg font-bold -mt-1">App Store</span>
              </div>
            </div>
            <div class="bg-black text-white px-4 py-3 lg:px-6 lg:py-4 rounded-lg flex items-center gap-3 border border-white/10">
              <svg class="w-6 h-6 lg:w-7 lg:h-7" fill="currentColor" viewBox="0 0 24 24">
                <path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"></path>
              </svg>
              <div class="flex flex-col items-start">
                <span class="text-sm lg:text-lg font-bold -mt-1">Google Play</span>
              </div>
            </div>
          </div>
        </div>
        
        <div class="mt-8">
          <p class="text-white/80 text-[0.8rem] sm:text-xs lg:text-base mb-4 text-center lg:text-left">
            Accede a la beta exclusiva
          </p>
          
          <form class="flex flex-row gap-4 max-w-md mx-auto lg:mx-0">
            <input
              type="email"
              name="email"
              placeholder="tu@email.com"
              class="flex-1 px-3 py-2 lg:px-4 lg:py-3 text-sm rounded-lg bg-white/10 border border-white/20 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-white/50 focus:border-transparent backdrop-blur-sm"
              required
            />
            <button
              type="submit"
              class="px-4 py-2 lg:px-6 lg:py-3 text-sm lg:text-base bg-white text-zinc-900 font-bold rounded-lg hover:scale-105 transition-transform duration-300 whitespace-nowrap"
            >
              Registrar
            </button>
          </form>
          
          <p class="text-white/50 text-[10px] lg:text-xs mt-3 text-left">
            * Cupos limitados
          </p>
        </div>
      </div>
      
      <!-- Columna de imagen -->
      <div class="flex justify-center lg:justify-end">
        <picture>
          <source media="(min-width: 1024px)" srcset="/assets/drippia-hero.png" />
          <img 
            src="/assets/hero-mobile.png" 
            alt="Drippia App Mockups" 
            class="w-auto h-[600px] sm:h-[700px] lg:h-[800px] xl:h-[900px] object-contain scale-200"
          />
        </picture>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes bounceSlow {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  .animate-fade-in {
    animation: fadeIn 800ms ease-out;
  }

  .animate-fade-in-delay {
    animation: fadeIn 800ms ease-out 300ms both;
  }

  .animate-fade-in-delay-2 {
    animation: fadeIn 800ms ease-out 600ms both;
  }

  .animate-bounce-slow {
    animation: bounceSlow 2s ease-in-out infinite;
  }
</style>

<script>
  // GSAP Animations
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  // TypeScript declaration for Google Analytics gtag
  declare global {
    function gtag(command: string, eventName: string, parameters?: Record<string, any>): void;
  }

  // Register plugins
  gsap.registerPlugin(ScrollTrigger);

  // Hero animations on load
  document.addEventListener('DOMContentLoaded', () => {
    // Timeline for hero entrance
    const tl = gsap.timeline();
    
    // Animate hero content
    tl.from('h1', {
      y: 100,
      opacity: 0,
      duration: 1.2,
      ease: 'power3.out'
    })
    .from('h1 + p', {
      y: 50,
      opacity: 0,
      duration: 0.8,
      ease: 'power2.out'
    }, '-=0.6')
    .from('.mb-2 lg:mb-4', {
      y: 30,
      opacity: 0,
      duration: 0.6,
      ease: 'power2.out'
    }, '-=0.4')
    .from('form', {
      y: 20,
      opacity: 0,
      duration: 0.6,
      ease: 'power2.out'
    }, '-=0.3')
    .from('picture img', {
      scale: 0.8,
      opacity: 0,
      duration: 1.4,
      ease: 'back.out(1.7)'
    }, '-=0.8')
    .from('.animate-bounce-slow', {
      opacity: 0,
      duration: 0.5
    }, '-=0.2');

    // Button hover effects
    const buttons = document.querySelectorAll('button[type="submit"], .bg-black');
    buttons.forEach(btn => {
      btn.addEventListener('mouseenter', () => {
        gsap.to(btn, {
          scale: 1.05,
          y: -2,
          duration: 0.3,
          ease: 'power2.out'
        });
      });

      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, {
          scale: 1,
          y: 0,
          duration: 0.3,
          ease: 'power2.out'
        });
      });
    });
  });

  const form = document.getElementById('beta-form') as HTMLFormElement;
  const message = document.getElementById('form-message') as HTMLParagraphElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const email = formData.get('email') as string;
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = button.textContent;

    // Animate button state
    gsap.to(button, {
      scale: 0.95,
      duration: 0.2
    });

    // Deshabilitar botón y mostrar loading
    button.disabled = true;
    button.textContent = 'Enviando...';

    try {
      const response = await fetch('/api/subscribe', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ email }),
      });

      const data = await response.json();

      if (response.ok) {
        message.textContent = '✓ ¡Registro exitoso! Revisa tu email.';
        message.className = 'text-green-400 text-[10px] lg:text-xs mt-2 lg:mt-3 text-left';
        form.reset();
        
        // Success animation
        gsap.from(message, {
          scale: 0.8,
          opacity: 0,
          duration: 0.5,
          ease: 'back.out(1.7)'
        });
        
        // Track conversion
        if (typeof gtag !== 'undefined') {
          gtag('event', 'beta_signup', {
            'event_category': 'engagement',
            'event_label': 'hero_form'
          });
        }
      } else {
        message.textContent = '✗ ' + (data.error || 'Error al registrar');
        message.className = 'text-red-400 text-[10px] lg:text-xs mt-2 lg:mt-3 text-left';
        
        // Error animation
        gsap.from(message, {
          x: -20,
          opacity: 0,
          duration: 0.5,
          ease: 'power2.out'
        });
      }
    } catch (error) {
      message.textContent = '✗ Error de conexión. Intenta de nuevo.';
      message.className = 'text-red-400 text-[10px] lg:text-xs mt-2 lg:mt-3 text-left';
      
      // Error animation
      gsap.from(message, {
        x: -20,
        opacity: 0,
        duration: 0.5,
        ease: 'power2.out'
      });
    } finally {
      button.disabled = false;
      button.textContent = originalText;
      
      // Reset button animation
      gsap.to(button, {
        scale: 1,
        duration: 0.2
      });
      
      // Restaurar mensaje original después de 5 segundos
      setTimeout(() => {
        message.textContent = '* Cupos limitados';
        message.className = 'text-white/50 text-[10px] lg:text-xs mt-2 lg:mt-3 text-left';
      }, 5000);
    }
  });
</script>

---
---

<section class="relative py-24 md:py-32 px-6">
  <div class="max-w-7xl mx-auto space-y-32 md:space-y-48 lg:space-y-64">

    <!-- Feature 1: Coach IA -->
    <div class="feature-block grid md:grid-cols-2 gap-12 lg:gap-24 items-center">
      <div class="feature-content order-2 md:order-1">
        <span class="text-palette-500 text-xs font-semibold tracking-[0.25em] uppercase mb-4 block">Coach IA</span>
        <h2 class="font-display text-[clamp(2rem,4.5vw,3.5rem)] font-bold leading-[1.08] mb-6 text-palette-50">
          Un barista experto<br/>en tu bolsillo
        </h2>
        <p class="text-palette-400 text-lg md:text-xl leading-relaxed mb-8">
          Pregúntale cualquier cosa sobre café. Diagnostica problemas, sugiere recetas y ajusta tu preparación en tiempo real.
        </p>
        <div class="space-y-3">
          <div class="flex items-center gap-3 text-palette-300">
            <span class="w-1.5 h-1.5 bg-palette-50 rounded-full shrink-0"></span>
            <span>"Mi café salió amargo" → Solución instantánea</span>
          </div>
          <div class="flex items-center gap-3 text-palette-300">
            <span class="w-1.5 h-1.5 bg-palette-50 rounded-full shrink-0"></span>
            <span>Recetas personalizadas para tus cafés</span>
          </div>
          <div class="flex items-center gap-3 text-palette-300">
            <span class="w-1.5 h-1.5 bg-palette-50 rounded-full shrink-0"></span>
            <span>Respuestas en tiempo real con streaming</span>
          </div>
        </div>
      </div>
      <div class="feature-visual order-1 md:order-2">
        <div class="bg-palette-700/50 rounded-3xl p-6 md:p-8 border border-palette-600/40 backdrop-blur-sm">
          <div class="space-y-4">
            <div class="flex justify-end">
              <div class="bg-palette-600 rounded-2xl rounded-tr-sm px-4 py-3 max-w-[80%]">
                <p class="text-palette-50 text-sm">Mi V60 salió muy amargo, ¿qué hice mal?</p>
              </div>
            </div>
            <div class="flex justify-start">
              <div class="bg-palette-800 rounded-2xl rounded-tl-sm px-4 py-3 max-w-[85%] border border-palette-600/30">
                <p class="text-palette-300 text-sm leading-relaxed">Suena a sobre-extracción. Prueba estos ajustes:</p>
                <ul class="text-palette-400 text-sm mt-2 space-y-1">
                  <li>→ Molienda más gruesa</li>
                  <li>→ Temperatura a 90°C</li>
                  <li>→ Ratio 1:17</li>
                </ul>
              </div>
            </div>
            <div class="flex justify-end">
              <div class="bg-palette-600 rounded-2xl rounded-tr-sm px-4 py-3 max-w-[80%]">
                <p class="text-palette-50 text-sm">¿Y si sigue ácido después del ajuste?</p>
              </div>
            </div>
            <div class="flex justify-start">
              <div class="bg-palette-800 rounded-2xl rounded-tl-sm px-4 py-3 max-w-[85%] border border-palette-600/30">
                <p class="text-palette-300 text-sm leading-relaxed">Si sigue ácido, muele más fino y sube a 92°C. También revisa tu tiempo total — debería estar entre 2:30 y 3:30.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Feature 2: Preparación Guiada -->
    <div class="feature-block grid md:grid-cols-2 gap-12 lg:gap-24 items-center">
      <div class="feature-visual">
        <div class="bg-palette-700/50 rounded-3xl p-6 md:p-8 border border-palette-600/40 backdrop-blur-sm">
          <div class="text-center mb-6">
            <span class="text-palette-500 text-sm font-medium">V60 · Paso 2 de 4</span>
            <div class="text-[clamp(3rem,7vw,5rem)] font-display font-bold text-palette-50 mt-2 tracking-tight">01:23</div>
            <div class="w-full bg-palette-600 rounded-full h-1 mt-4 overflow-hidden">
              <div class="bg-palette-50 h-1 rounded-full transition-all duration-1000" style="width: 40%"></div>
            </div>
          </div>
          <div class="space-y-3">
            <div class="bg-palette-800 rounded-xl p-3 border border-palette-600/30 opacity-50">
              <div class="flex justify-between items-center">
                <span class="text-palette-500 text-sm">✓ Bloom</span>
                <span class="text-palette-500 text-xs font-mono">0:00 — 0:45</span>
              </div>
            </div>
            <div class="bg-palette-800 rounded-xl p-3.5 border border-palette-50/20">
              <div class="flex justify-between items-center">
                <span class="text-palette-50 text-sm font-semibold">→ Primera vertida</span>
                <span class="text-palette-400 text-xs font-mono">0:45 — 1:30</span>
              </div>
              <p class="text-palette-400 text-xs mt-1.5">100ml · movimiento circular</p>
            </div>
            <div class="bg-palette-800 rounded-xl p-3 border border-palette-600/30 opacity-30">
              <div class="flex justify-between items-center">
                <span class="text-palette-500 text-sm">Segunda vertida</span>
                <span class="text-palette-500 text-xs font-mono">1:30 — 2:15</span>
              </div>
            </div>
            <div class="bg-palette-800 rounded-xl p-3 border border-palette-600/30 opacity-20">
              <div class="flex justify-between items-center">
                <span class="text-palette-500 text-sm">Drawdown</span>
                <span class="text-palette-500 text-xs font-mono">2:15 — 3:00</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="feature-content">
        <span class="text-palette-500 text-xs font-semibold tracking-[0.25em] uppercase mb-4 block">Brew Guide</span>
        <h2 class="font-display text-[clamp(2rem,4.5vw,3.5rem)] font-bold leading-[1.08] mb-6 text-palette-50">
          Cada paso hacia<br/>la taza perfecta
        </h2>
        <p class="text-palette-400 text-lg md:text-xl leading-relaxed mb-8">
          Timer integrado con guía paso a paso. V60, Chemex, AeroPress, French Press y más. Nunca más quemes un café.
        </p>
        <div class="space-y-3">
          <div class="flex items-center gap-3 text-palette-300">
            <span class="w-1.5 h-1.5 bg-palette-50 rounded-full shrink-0"></span>
            <span>Propuestas inteligentes según tus preferencias</span>
          </div>
          <div class="flex items-center gap-3 text-palette-300">
            <span class="w-1.5 h-1.5 bg-palette-50 rounded-full shrink-0"></span>
            <span>Control preciso de cantidades y tiempos</span>
          </div>
          <div class="flex items-center gap-3 text-palette-300">
            <span class="w-1.5 h-1.5 bg-palette-50 rounded-full shrink-0"></span>
            <span>Califica y guarda cada preparación</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Feature 3: Biblioteca de Cafés -->
    <div class="feature-block grid md:grid-cols-2 gap-12 lg:gap-24 items-center">
      <div class="feature-content order-2 md:order-1">
        <span class="text-palette-500 text-xs font-semibold tracking-[0.25em] uppercase mb-4 block">Colección</span>
        <h2 class="font-display text-[clamp(2rem,4.5vw,3.5rem)] font-bold leading-[1.08] mb-6 text-palette-50">
          Cada grano cuenta<br/>una historia
        </h2>
        <p class="text-palette-400 text-lg md:text-xl leading-relaxed mb-8">
          Cataloga cada café que compras. Origen, varietal, proceso, tueste y notas de cata. Tu biblioteca personal de café de especialidad.
        </p>
        <div class="space-y-3">
          <div class="flex items-center gap-3 text-palette-300">
            <span class="w-1.5 h-1.5 bg-palette-50 rounded-full shrink-0"></span>
            <span>Foto del empaque para identificación rápida</span>
          </div>
          <div class="flex items-center gap-3 text-palette-300">
            <span class="w-1.5 h-1.5 bg-palette-50 rounded-full shrink-0"></span>
            <span>Comparte cafés con QR o enlace directo</span>
          </div>
          <div class="flex items-center gap-3 text-palette-300">
            <span class="w-1.5 h-1.5 bg-palette-50 rounded-full shrink-0"></span>
            <span>Historial de preparaciones por cada café</span>
          </div>
        </div>
      </div>
      <div class="feature-visual order-1 md:order-2">
        <div class="bg-palette-700/50 rounded-3xl p-6 md:p-8 border border-palette-600/40 backdrop-blur-sm">
          <div class="grid grid-cols-2 gap-3">
            <!-- Coffee Card 1 -->
            <div class="bg-palette-800 rounded-2xl overflow-hidden border border-palette-600/30 group">
              <div class="h-24 bg-gradient-to-br from-palette-600 to-palette-700 relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-t from-palette-800/50 to-transparent"></div>
              </div>
              <div class="p-3">
                <h4 class="text-palette-50 font-semibold text-sm">Geisha Panama</h4>
                <p class="text-palette-500 text-xs mt-1">Natural · Boquete · 1900m</p>
                <div class="flex items-center gap-1.5 mt-2">
                  <span class="text-palette-400 text-xs">★★★★★</span>
                  <span class="text-palette-500 text-[10px]">88 pts</span>
                </div>
              </div>
            </div>
            <!-- Coffee Card 2 -->
            <div class="bg-palette-800 rounded-2xl overflow-hidden border border-palette-600/30 group">
              <div class="h-24 bg-gradient-to-br from-palette-500 to-palette-600 relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-t from-palette-800/50 to-transparent"></div>
              </div>
              <div class="p-3">
                <h4 class="text-palette-50 font-semibold text-sm">Ethiopia Yirgacheffe</h4>
                <p class="text-palette-500 text-xs mt-1">Washed · Sidamo · 1850m</p>
                <div class="flex items-center gap-1.5 mt-2">
                  <span class="text-palette-400 text-xs">★★★★☆</span>
                  <span class="text-palette-500 text-[10px]">85 pts</span>
                </div>
              </div>
            </div>
            <!-- Coffee Card 3 -->
            <div class="bg-palette-800 rounded-2xl overflow-hidden border border-palette-600/30 group">
              <div class="h-24 bg-gradient-to-br from-palette-700 to-palette-800 relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-t from-palette-800/50 to-transparent"></div>
              </div>
              <div class="p-3">
                <h4 class="text-palette-50 font-semibold text-sm">Colombia Huila</h4>
                <p class="text-palette-500 text-xs mt-1">Honey · Pitalito · 1750m</p>
                <div class="flex items-center gap-1.5 mt-2">
                  <span class="text-palette-400 text-xs">★★★★☆</span>
                  <span class="text-palette-500 text-[10px]">84 pts</span>
                </div>
              </div>
            </div>
            <!-- Add New -->
            <div class="bg-palette-800 rounded-2xl border-2 border-dashed border-palette-600/40 flex items-center justify-center min-h-[160px] hover:border-palette-500 transition-colors cursor-pointer">
              <div class="text-center">
                <span class="text-palette-500 text-3xl block mb-1">+</span>
                <p class="text-palette-500 text-xs">Agregar café</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Feature 4: Brewlog -->
    <div class="feature-block grid md:grid-cols-2 gap-12 lg:gap-24 items-center">
      <div class="feature-visual">
        <div class="bg-palette-700/50 rounded-3xl p-6 md:p-8 border border-palette-600/40 backdrop-blur-sm">
          <!-- Stats -->
          <div class="grid grid-cols-3 gap-4 mb-8">
            <div class="text-center">
              <div class="text-3xl font-display font-bold text-palette-50">47</div>
              <div class="text-palette-500 text-xs mt-1">Brews</div>
            </div>
            <div class="text-center border-x border-palette-600/30">
              <div class="text-3xl font-display font-bold text-palette-50">12</div>
              <div class="text-palette-500 text-xs mt-1">Racha</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-display font-bold text-palette-50">4.2</div>
              <div class="text-palette-500 text-xs mt-1">Rating</div>
            </div>
          </div>
          <!-- Activity Chart (simplified) -->
          <div class="flex items-end gap-1 mb-8 h-16 justify-center">
            <div class="w-2 rounded-full bg-palette-600" style="height: 30%"></div>
            <div class="w-2 rounded-full bg-palette-600" style="height: 50%"></div>
            <div class="w-2 rounded-full bg-palette-600" style="height: 70%"></div>
            <div class="w-2 rounded-full bg-palette-600" style="height: 40%"></div>
            <div class="w-2 rounded-full bg-palette-50" style="height: 90%"></div>
            <div class="w-2 rounded-full bg-palette-600" style="height: 60%"></div>
            <div class="w-2 rounded-full bg-palette-600" style="height: 80%"></div>
            <div class="w-2 rounded-full bg-palette-600" style="height: 45%"></div>
            <div class="w-2 rounded-full bg-palette-600" style="height: 65%"></div>
            <div class="w-2 rounded-full bg-palette-50" style="height: 100%"></div>
            <div class="w-2 rounded-full bg-palette-600" style="height: 55%"></div>
            <div class="w-2 rounded-full bg-palette-600" style="height: 75%"></div>
          </div>
          <!-- Recent Brews -->
          <div class="space-y-3">
            <div class="bg-palette-800 rounded-xl p-3.5 border border-palette-600/30">
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-palette-50 text-sm font-semibold">Geisha Panama</span>
                  <p class="text-palette-500 text-xs mt-0.5">V60 · 1:16.5 · ★★★★★</p>
                </div>
                <span class="text-palette-500 text-xs">Hoy</span>
              </div>
            </div>
            <div class="bg-palette-800 rounded-xl p-3.5 border border-palette-600/30">
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-palette-50 text-sm font-semibold">Ethiopia Yirg</span>
                  <p class="text-palette-500 text-xs mt-0.5">Chemex · 1:15 · ★★★★☆</p>
                </div>
                <span class="text-palette-500 text-xs">Ayer</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="feature-content">
        <span class="text-palette-500 text-xs font-semibold tracking-[0.25em] uppercase mb-4 block">Brewlog</span>
        <h2 class="font-display text-[clamp(2rem,4.5vw,3.5rem)] font-bold leading-[1.08] mb-6 text-palette-50">
          Tu evolución<br/>como barista
        </h2>
        <p class="text-palette-400 text-lg md:text-xl leading-relaxed mb-8">
          Cada brew queda registrado. Compara variaciones, encuentra patrones y perfecciona tu técnica con datos reales.
        </p>
        <div class="space-y-3">
          <div class="flex items-center gap-3 text-palette-300">
            <span class="w-1.5 h-1.5 bg-palette-50 rounded-full shrink-0"></span>
            <span>Estadísticas de progreso y tendencias</span>
          </div>
          <div class="flex items-center gap-3 text-palette-300">
            <span class="w-1.5 h-1.5 bg-palette-50 rounded-full shrink-0"></span>
            <span>Recrear preparaciones exitosas con un toque</span>
          </div>
          <div class="flex items-center gap-3 text-palette-300">
            <span class="w-1.5 h-1.5 bg-palette-50 rounded-full shrink-0"></span>
            <span>Análisis del Coach IA sobre tu historial</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.feature-block').forEach((block) => {
      const content = block.querySelector('.feature-content');
      const visual = block.querySelector('.feature-visual');

      if (content) {
        gsap.from(content.children, {
          y: 50,
          opacity: 0,
          stagger: 0.08,
          duration: 0.9,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: block,
            start: 'top 78%',
            toggleActions: 'play none none none',
          },
        });
      }

      if (visual) {
        gsap.from(visual, {
          y: 80,
          opacity: 0,
          duration: 1.1,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: block,
            start: 'top 78%',
            toggleActions: 'play none none none',
          },
        });
      }
    });
  });
</script>

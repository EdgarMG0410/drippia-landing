---
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3">
        <img src="/assets/logowhite.svg" alt="Drippia" class="h-10 w-auto" />
        <span class="text-[#f8f9fa] font-display text-xl font-medium tracking-tight hidden sm:inline">Drippia</span>
      </a>

      <!-- CTA Button -->
      <a
        href="#beta"
        class="inline-flex items-center px-5 py-2.5 bg-[#f8f9fa] text-[#212529] text-sm font-semibold rounded-full hover:bg-[#e9ecef] transition-colors duration-300"
      >
        Únete a la beta
      </a>
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar');

  window.addEventListener('scroll', () => {
    if (!navbar) return;
    if (window.scrollY > 80) {
      navbar.style.backgroundColor = 'rgba(33, 37, 41, 0.9)';
      navbar.style.backdropFilter = 'blur(24px)';
      (navbar.style as any).webkitBackdropFilter = 'blur(24px)';
      navbar.style.borderBottom = '1px solid rgba(73, 80, 87, 0.4)';
    } else {
      navbar.style.backgroundColor = 'transparent';
      navbar.style.backdropFilter = 'none';
      (navbar.style as any).webkitBackdropFilter = 'none';
      navbar.style.borderBottom = 'none';
    }
  });
</script>

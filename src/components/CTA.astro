---
---

<section id="beta" class="relative py-32 md:py-48 px-6">
  <!-- Subtle gradient background -->
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-palette-700/20 to-transparent pointer-events-none"></div>

  <div class="relative z-10 max-w-3xl mx-auto text-center">
    <h2 class="cta-title font-display text-[clamp(2.5rem,7vw,5rem)] font-bold leading-[1.02] tracking-tight mb-6 text-palette-50">
      Tu próximo café<br/>será perfecto
    </h2>
    <p class="cta-subtitle text-palette-400 text-lg md:text-xl mb-12 max-w-xl mx-auto leading-relaxed">
      Únete a la lista de espera y sé de los primeros en probar Drippia. Acceso anticipado + beneficios exclusivos.
    </p>

    <!-- Beta Form -->
    <form id="cta-form" class="cta-form flex flex-col sm:flex-row gap-3 max-w-lg mx-auto mb-4">
      <input
        type="email"
        name="email"
        placeholder="tu@email.com"
        class="flex-1 px-6 py-4 text-base rounded-full bg-palette-700 border border-palette-600 text-palette-50 placeholder-palette-500 focus:outline-none focus:border-palette-400 transition-colors duration-300"
        required
      />
      <button
        type="submit"
        class="px-10 py-4 text-base bg-palette-50 text-palette-800 font-bold rounded-full hover:bg-palette-100 transition-all duration-300 whitespace-nowrap"
      >
        Unirme a la beta
      </button>
    </form>

    <p id="cta-form-msg" class="text-palette-500 text-sm mb-16">
      Sin spam, prometido.
    </p>

    <!-- Store Buttons -->
    <div class="cta-stores flex flex-col sm:flex-row gap-4 justify-center items-center">
      <div class="flex items-center gap-3 px-6 py-3.5 bg-palette-700 border border-palette-600 rounded-xl text-palette-300 hover:border-palette-500 transition-colors cursor-default">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"></path></svg>
        <div class="flex flex-col items-start">
          <span class="text-palette-500 text-[10px] leading-none">Próximamente en</span>
          <span class="text-palette-50 text-sm font-semibold">App Store</span>
        </div>
      </div>
      <div class="flex items-center gap-3 px-6 py-3.5 bg-palette-700 border border-palette-600 rounded-xl text-palette-300 hover:border-palette-500 transition-colors cursor-default">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"></path></svg>
        <div class="flex flex-col items-start">
          <span class="text-palette-500 text-[10px] leading-none">Disponible en</span>
          <span class="text-palette-50 text-sm font-semibold">Google Play</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('beta');
    if (!section) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top 70%',
        toggleActions: 'play none none none',
      },
    });

    tl.from('.cta-title', { y: 50, opacity: 0, duration: 0.9, ease: 'power3.out' })
      .from('.cta-subtitle', { y: 30, opacity: 0, duration: 0.7, ease: 'power2.out' }, '-=0.5')
      .from('.cta-form', { y: 20, opacity: 0, duration: 0.6, ease: 'power2.out' }, '-=0.3')
      .from('.cta-stores', { y: 20, opacity: 0, duration: 0.6, ease: 'power2.out' }, '-=0.2');
  });

  // Form handling
  const form = document.getElementById('cta-form') as HTMLFormElement;
  const msg = document.getElementById('cta-form-msg') as HTMLParagraphElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = new FormData(form).get('email') as string;
    if (!email) return;

    const btn = form.querySelector('button')!;
    btn.textContent = 'Enviando...';
    btn.disabled = true;

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });

      if (res.ok) {
        msg.textContent = '✓ Te hemos agregado a la lista de espera';
        msg.style.color = '#adb5bd';
        form.reset();
        btn.textContent = '✓ Registrado';
      } else {
        throw new Error();
      }
    } catch {
      msg.textContent = 'Error al registrar. Intenta de nuevo.';
      msg.style.color = '#dc3545';
      btn.textContent = 'Unirme a la beta';
    }

    btn.disabled = false;

    setTimeout(() => {
      msg.textContent = 'Sin spam, prometido.';
      msg.style.color = '';
      btn.textContent = 'Unirme a la beta';
    }, 4000);
  });
</script>
